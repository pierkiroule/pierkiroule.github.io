<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Soirée des Sosies presque parfait.e.s</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      overflow: hidden;
      font-family: system-ui, sans-serif;
      color: white;
      background:
        radial-gradient(circle at 20% 20%, #ff00cc, transparent 30%),
        radial-gradient(circle at 80% 30%, #00f5ff, transparent 35%),
        radial-gradient(circle at 50% 90%, #ffe600, transparent 30%),
        linear-gradient(135deg, #050014, #120026 45%, #000);
    }

    canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    .screen {
      position: relative;
      z-index: 2;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 22px;
      text-align: center;
    }

    .card {
      width: min(760px, 100%);
      padding: 34px 22px;
      border-radius: 34px;
      background: rgba(0, 0, 0, 0.36);
      border: 1px solid rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(16px);
      box-shadow:
        0 0 50px rgba(255, 0, 204, 0.4),
        0 0 90px rgba(0, 245, 255, 0.25);
    }

    .badge {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 999px;
      background: linear-gradient(90deg, #ff00cc, #00f5ff);
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.78rem;
      margin-bottom: 18px;
      animation: pulse 1.8s infinite;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.3rem, 9vw, 5.7rem);
      line-height: 0.88;
      text-transform: uppercase;
      text-shadow:
        0 0 12px #ff00cc,
        0 0 28px #00f5ff;
    }

    h1 span {
      display: block;
      margin-top: 14px;
      font-size: 0.42em;
      font-weight: 500;
      text-transform: none;
      letter-spacing: 0.03em;
    }

    .date {
      margin: 24px 0;
      font-size: clamp(1.15rem, 4vw, 1.7rem);
      font-weight: 700;
      color: #fff3a3;
      text-shadow: 0 0 14px #ffe600;
    }

    .countdown {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 20px;
    }

    .box {
      padding: 18px 8px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.13);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: inset 0 0 22px rgba(255, 255, 255, 0.08);
    }

    .number {
      font-size: clamp(2.1rem, 9vw, 4.3rem);
      font-weight: 900;
      line-height: 1;
    }

    .label {
      margin-top: 7px;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      opacity: 0.82;
    }

    .message {
      margin-top: 26px;
      font-size: clamp(1.15rem, 4vw, 1.6rem);
      font-weight: 800;
    }

    button {
      margin-top: 20px;
      border: 0;
      border-radius: 999px;
      padding: 14px 24px;
      font-size: 1rem;
      font-weight: 900;
      cursor: pointer;
      color: #050014;
      background: linear-gradient(90deg, #ffe600, #00f5ff, #ff00cc);
      box-shadow: 0 0 28px rgba(255, 255, 255, 0.45);
    }

    audio {
      display: none;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); filter: brightness(1); }
      50% { transform: scale(1.06); filter: brightness(1.35); }
    }

    @media (max-width: 560px) {
      .countdown {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>

<body>
  <canvas id="canvas"></canvas>

  <div class="screen">
    <main class="card">
      <div class="badge">Compte à rebours live</div>

      <h1>
        Soirée des Sosies
        <span>presque parfait.e.s</span>
      </h1>

      <div class="date">27 juin 2026 · 19h30</div>

      <section class="countdown">
        <div class="box">
          <div class="number" id="days">00</div>
          <div class="label">jours</div>
        </div>
        <div class="box">
          <div class="number" id="hours">00</div>
          <div class="label">heures</div>
        </div>
        <div class="box">
          <div class="number" id="minutes">00</div>
          <div class="label">minutes</div>
        </div>
        <div class="box">
          <div class="number" id="seconds">00</div>
          <div class="label">secondes</div>
        </div>
      </section>

      <div class="message" id="message">
        Prépare ton double. Le dancefloor ouvre bientôt.
      </div>

      <button id="playBtn">▶ Lancer le son</button>

      <audio id="audio" crossorigin="anonymous">
        <source src="https://raw.githubusercontent.com/pierkiroule/pierkiroule.github.io/master/sozi/Sozi%20Qui%20Sait.mp3" type="audio/mpeg">
      </audio>
    </main>
  </div>

  <script>
    const targetDate = new Date("2026-06-27T19:30:00+02:00").getTime();

    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");
    const messageEl = document.getElementById("message");

    function pad(n) {
      return String(n).padStart(2, "0");
    }

    function updateCountdown() {
      const now = Date.now();
      const distance = targetDate - now;

      if (distance <= 0) {
        daysEl.textContent = "00";
        hoursEl.textContent = "00";
        minutesEl.textContent = "00";
        secondsEl.textContent = "00";
        messageEl.textContent = "C’est maintenant. Les sosies entrent en scène.";
        return;
      }

      daysEl.textContent = pad(Math.floor(distance / 86400000));
      hoursEl.textContent = pad(Math.floor(distance / 3600000) % 24);
      minutesEl.textContent = pad(Math.floor(distance / 60000) % 60);
      secondsEl.textContent = pad(Math.floor(distance / 1000) % 60);
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");
    const audio = document.getElementById("audio");
    const playBtn = document.getElementById("playBtn");

    let width;
    let height;
    let audioCtx;
    let analyser;
    let dataArray;
    let source;
    let audioReady = false;

    const bubbles = [];

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener("resize", resize);
    resize();

    for (let i = 0; i < 90; i++) {
      bubbles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        r: 3 + Math.random() * 16,
        speed: 0.3 + Math.random() * 1.7,
        drift: -0.7 + Math.random() * 1.4,
        hue: Math.random() * 360,
        alpha: 0.25 + Math.random() * 0.55
      });
    }

    playBtn.addEventListener("click", async () => {
      if (!audioReady) {
        audioCtx = new AudioContext();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;

        source = audioCtx.createMediaElementSource(audio);
        source.connect(analyser);
        analyser.connect(audioCtx.destination);

        dataArray = new Uint8Array(analyser.frequencyBinCount);
        audioReady = true;
      }

      if (audioCtx.state === "suspended") {
        await audioCtx.resume();
      }

      if (audio.paused) {
        await audio.play();
        playBtn.textContent = "⏸ Pause";
      } else {
        audio.pause();
        playBtn.textContent = "▶ Relancer le son";
      }
    });

    function drawBackground(level) {
      const gradient = ctx.createRadialGradient(
        width / 2,
        height / 2,
        0,
        width / 2,
        height / 2,
        Math.max(width, height)
      );

      gradient.addColorStop(0, `rgba(255, 0, 204, ${0.15 + level * 0.4})`);
      gradient.addColorStop(0.45, `rgba(0, 245, 255, ${0.12 + level * 0.3})`);
      gradient.addColorStop(1, "rgba(0, 0, 0, 0.92)");

      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);
    }

    function drawBubbles(level) {
      bubbles.forEach(b => {
        b.y -= b.speed + level * 4;
        b.x += b.drift;

        if (b.y < -40) {
          b.y = height + 40;
          b.x = Math.random() * width;
        }

        ctx.beginPath();
        ctx.arc(b.x, b.y, b.r + level * 12, 0, Math.PI * 2);
        ctx.strokeStyle = `hsla(${b.hue}, 100%, 70%, ${b.alpha})`;
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(b.x - b.r * 0.25, b.y - b.r * 0.25, b.r * 0.28, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${b.alpha})`;
        ctx.fill();
      });
    }

    function drawVisualizer(level) {
      if (!audioReady) return;

      analyser.getByteFrequencyData(dataArray);

      const bars = dataArray.length;
      const centerX = width / 2;
      const centerY = height / 2;
      const radius = Math.min(width, height) * 0.25;

      for (let i = 0; i < bars; i++) {
        const value = dataArray[i];
        const angle = (i / bars) * Math.PI * 2;
        const barLength = value * 0.9;

        const x1 = centerX + Math.cos(angle) * radius;
        const y1 = centerY + Math.sin(angle) * radius;
        const x2 = centerX + Math.cos(angle) * (radius + barLength);
        const y2 = centerY + Math.sin(angle) * (radius + barLength);

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = `hsla(${i * 3}, 100%, 65%, ${0.35 + level})`;
        ctx.lineWidth = 3;
        ctx.shadowBlur = 18;
        ctx.shadowColor = `hsl(${i * 3}, 100%, 65%)`;
        ctx.stroke();
        ctx.shadowBlur = 0;
      }
    }

    function drawCenterPulse(level) {
      const r = 90 + level * 130;

      ctx.beginPath();
      ctx.arc(width / 2, height / 2, r, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(255, 255, 255, ${0.14 + level * 0.5})`;
      ctx.lineWidth = 4;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(width / 2, height / 2, r * 0.55, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(255, 230, 0, ${0.12 + level * 0.5})`;
      ctx.lineWidth = 3;
      ctx.stroke();
    }

    function animate() {
      let level = 0.15;

      if (audioReady) {
        analyser.getByteFrequencyData(dataArray);
        const avg = dataArray.reduce((a, b) => a + b, 0) / dataArray.length;
        level = avg / 255;
      }

      drawBackground(level);
      drawBubbles(level);
      drawCenterPulse(level);
      drawVisualizer(level);

      requestAnimationFrame(animate);
    }

    animate();
  </script>
</body>
</html>
